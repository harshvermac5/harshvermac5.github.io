<ul class="card-text font-weight-light cv-education-list">
  {% for entry in entries %}
    {% capture study_type %}
      {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
    {% endcapture %}
    {% assign study_type = study_type | strip %}

    {% capture end_date %}
      {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
    {% endcapture %}
    {% assign end_date = end_date | strip | split: '-' | first %}

    <li class="cv-education-item">
      <div class="cv-education-heading">
        <div>
          {% if entry.url %}
            <h4>
              <a href="{{ entry.url }}">{{ study_type }}</a>
            </h4>
          {% else %}
            <h4>{{ study_type }}</h4>
          {% endif %}
          <p class="cv-education-institution">{{ entry.institution }}</p>
        </div>

        {% if end_date != '' %}
          <span class="cv-education-year">{{ end_date }}</span>
        {% endif %}
      </div>

      <dl class="cv-education-details">
        {% if entry.area %}
          <div>
            <dt>Area</dt>
            <dd>{{ entry.area }}</dd>
          </div>
        {% endif %}
        {% if entry.location %}
          <div>
            <dt>Location</dt>
            <dd>{{ entry.location }}</dd>
          </div>
        {% endif %}
        {% if entry.score %}
          <div>
            <dt>Score</dt>
            <dd>{{ entry.score }}</dd>
          </div>
        {% endif %}
      </dl>

      {% if entry.courses or entry.highlights %}
        <ul class="cv-education-highlights">
          {% for item in entry.courses %}
            <li>{{ item }}</li>
          {% endfor %}
          {% for item in entry.highlights %}
            <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>

<style>
  .cv-education-list {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cv-education-item {
    background: color-mix(in srgb, var(--global-theme-color) 4%, var(--global-card-bg-color));
    border: 1px solid var(--global-divider-color);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .cv-education-heading {
    align-items: start;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .cv-education-heading h4 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  .cv-education-institution {
    color: var(--global-text-color-light);
    margin: 0.3rem 0 0;
  }

  .cv-education-year {
    background: var(--global-theme-color);
    border-radius: 999px;
    color: var(--global-bg-color);
    flex: 0 0 auto;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
  }

  .cv-education-details {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 1rem 0 0;
  }

  .cv-education-details div {
    min-width: 0;
  }

  .cv-education-details dt {
    color: var(--global-text-color-light);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cv-education-details dd {
    margin: 0.2rem 0 0;
  }

  .cv-education-details dd {
    overflow-wrap: anywhere;
  }

  .cv-education-highlights {
    margin: 0.9rem 0 0;
    padding-left: 1.25rem;
  }

  @media (max-width: 575px) {
    .cv-education-heading {
      align-items: flex-start;
      flex-direction: column-reverse;
    }

    .cv-education-details {
      grid-template-columns: 1fr;
    }
  }
</style>
